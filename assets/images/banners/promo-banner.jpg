<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="320" viewBox="0 0 1200 320" fill="none">
  <defs>
    <linearGradient id="promoGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#C96F91"/>
      <stop offset="40%" stop-color="#D982A1"/>
      <stop offset="100%" stop-color="#E8A0B8"/>
    </linearGradient>
    <pattern id="petalPat" width="60" height="60" patternUnits="userSpaceOnUse">
      <circle cx="30" cy="30" r="1.5" fill="#FFFFFF" opacity="0.25"/>
      <circle cx="10" cy="10" r="1" fill="#FFFFFF" opacity="0.15"/>
    </pattern>
  </defs>
  <rect width="1200" height="320" rx="20" fill="url(#promoGrad)"/>
  <rect width="1200" height="320" rx="20" fill="url(#petalPat)"/>
  
  <!-- Subtle decorative rings -->
  <circle cx="1050" cy="160" r="220" stroke="#FFFFFF" stroke-width="1.5" stroke-opacity="0.2"/>
  <circle cx="1050" cy="160" r="170" stroke="#FFFFFF" stroke-width="1" stroke-opacity="0.15"/>
  <circle cx="1050" cy="160" r="120" stroke="#FFFFFF" stroke-width="0.8" stroke-opacity="0.1"/>

  <text x="80" y="110" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="700" letter-spacing="3" fill="#FFE5EE">PENAWARAN SPESIAL BULAN INI</text>
  <text x="80" y="165" font-family="'Cormorant Garamond', Georgia, serif" font-size="44" font-weight="700" fill="#FFFFFF">Gratis Ongkir ke Seluruh Indonesia</text>
  <text x="80" y="210" font-family="'Plus Jakarta Sans', sans-serif" font-size="16" fill="#FFF0F5">Untuk setiap pembelian minimal Rp 200.000 + Bonus 3 Sampel Mewah</text>

  <rect x="80" y="240" width="180" height="44" rx="22" fill="#FFFFFF"/>
  <text x="170" y="267" font-family="'Plus Jakarta Sans', sans-serif" font-size="14" font-weight="700" fill="#C96F91" text-anchor="middle">Klaim Promo →</text>
</svg>
